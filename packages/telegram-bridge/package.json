{
  "name": "codex-telegram-multibot",
  "version": "0.1.0",
  "type": "module",
  "description": "Run one sandboxed Codex agent per Telegram bot/project.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "grammy": "^1.38.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
