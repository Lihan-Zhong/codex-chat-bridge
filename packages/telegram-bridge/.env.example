# Required
TELEGRAM_BOT_TOKEN=
CODEX_PROJECT_DIR=/absolute/path/to/project

# Comma-separated Telegram user IDs. Empty means nobody is allowed.
TELEGRAM_ALLOWED_USER_IDS=

# Optional chat IDs. Empty permits private/group chats from allowlisted users.
TELEGRAM_ALLOWED_CHAT_IDS=

# In groups, require an @mention unless this is false. Private chats never require it.
TELEGRAM_REQUIRE_MENTION=true

# Codex settings
CODEX_BIN=codex
# Set this to share one app-server with a tmux Codex TUI. Leave empty for
# bridge-owned stdio mode. Use localhost unless TLS/auth is configured.
CODEX_APP_SERVER_URL=
# Optional bearer/capability token for an authenticated WebSocket listener.
CODEX_APP_SERVER_TOKEN=
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never

# Runtime state; stores Telegram-chat -> Codex-thread mappings.
CODEX_TELEGRAM_STATE_DIR=.state
