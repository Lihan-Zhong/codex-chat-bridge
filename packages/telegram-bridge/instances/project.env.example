TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_REQUIRE_MENTION=true

CODEX_PROJECT_DIR=/absolute/path/to/project
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never

# Give every bot instance a distinct state path.
CODEX_TELEGRAM_STATE_DIR=/absolute/path/to/codex-telegram-multibot/.state/project-name
